{
	"singleQuote": true,
	"trailingComma": "all",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"bracketSameLine": true,
	"endOfLine": "lf",
	"jsxSingleQuote": true,
	"printWidth": 100,
	"bracketSpacing": true,
	"arrowParens": "always",
	"experimentalOperatorPosition": "end",
	"proseWrap": "preserve",
	"quoteProps": "as-needed"
}
